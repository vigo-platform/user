# Copy to untracked .env; Compose loads it, Spring itself does not.
# DEVELOPMENT ONLY: no JWT validation bypass. Obtain actual RS256 access tokens from Auth.
APP_NETWORK_NAME=vigo-app
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vigo_user_service
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Compose uses kafka:9092 internally; host processes use localhost:19092.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
AUTH_JWKS_URI=http://auth:8080/.well-known/jwks.json
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=vigo-api
# Explicit insecure exception ONLY for dev with current Auth plaintext client.
# All containers on the shared network can reach this credential port: trust dev peers only.
GRPC_DEV_PLAINTEXT_ENABLED=false
GRPC_BIND_ADDRESS=127.0.0.1
GRPC_PORT=50051
GRPC_TLS_CERTIFICATE=
GRPC_TLS_PRIVATE_KEY=
GRPC_TLS_TRUST_CERTIFICATE=
GRPC_AUTH_SERVICE_IDENTITY=spiffe://vigo.local/service/auth
# Disabled by default; example policy P90D
CREDENTIALS_MAX_AGE=PT0S
