meta {
  name: Set user status admin
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/api/v1/users/{{user_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{process.env.USER_BEARER_TOKEN}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "SUSPENDED",
    "reason": "Synthetic moderation example"
  }
}

tests {
  test("Expected success status", function () { expect(res.getStatus()).to.equal(200); });
}

docs {
  Saved success response example (HTTP 200):
  ```json
  {
    "success": true,
    "code": "SUCCESS",
    "message": "Operation successful",
    "messageFa": "عملیات موفق بود",
    "data": {
      "displayName": "Synthetic User",
      "avatarUrl": null,
      "birthDate": "1995-01-01",
      "gender": "OTHER",
      "userId": 4,
      "email": "synthetic@example.test",
      "phone": null,
      "role": "ATHLETE",
      "status": "SUSPENDED",
      "createdAt": "2026-10-31T12:00:00Z",
