meta {
  name: Get public coach
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/coaches/{{coach_id}}
  body: none
  auth: none
}

tests {
  test("Expected success status", function () { expect(res.getStatus()).to.equal(200); });
  test("Returns public plan summaries with up to three feature labels", function () {
    const { data } = res.getBody();
    expect(data.plans).to.be.an("array");
    for (const plan of data.plans) {
      expect(plan).to.include.all.keys("id", "title", "summary", "price_rial", "compare_at_price_rial",
        "duration_days", "is_recommended", "display_order", "features");
      expect(plan.features).to.be.an("array");
      expect(plan.features.length).to.be.at.most(3);
      for (const feature of plan.features) expect(feature).to.have.all.keys("id", "code", "label");
    }
  });
}

