meta {
  name: List users admin
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/users?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{process.env.USER_BEARER_TOKEN}}
}

tests {
  test("Expected success status", function () { expect(res.getStatus()).to.equal(200); });
}

