meta {
  name: List public coach applications admin
  type: http
  seq: 8
}

get {
  url: {{base_url}}/api/v1/admin/coaches/applications?page=0&size=20&status=PENDING
  body: none
  auth: bearer
}

auth:bearer {
  token: {{process.env.USER_BEARER_TOKEN}}
}

tests {
  test("Returns a page of applications", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data.content).to.be.an("array");
  });
}

docs {
  Use an ADMIN access token. The optional status filter accepts PENDING, APPROVED, or REJECTED.
  Use applicationId from an item to review that application.
}
