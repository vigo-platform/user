meta {
  name: Reject coach admin
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/admin/coaches/{{coach_id}}/reject
  body: json
  auth: bearer
}

auth:bearer {
  token: {{process.env.USER_BEARER_TOKEN}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reason": "Please provide a verifiable certification"
  }
}

tests {
  test("Expected success status", function () { expect(res.getStatus()).to.equal(200); });
}

docs {
