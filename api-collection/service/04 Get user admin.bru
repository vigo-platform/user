meta {
  name: Get user admin
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/v1/users/{{user_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{process.env.USER_BEARER_TOKEN}}
}

tests {
  test("Expected success status", function () { expect(res.getStatus()).to.equal(200); });
}

docs {
