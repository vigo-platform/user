meta {
  name: Update coach plan
  type: http
  seq: 6
}

patch {
  url: {{base_url}}/api/v1/coaches/me/plans/{{created_coach_plan_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{process.env.USER_BEARER_TOKEN}}
}

body:json {
  {
  //   "price": 130000,
  //   "description": null,
  //   "includes": [{ "code": "WORKOUT" }],
  //   "fields": [
  //     { "fieldId": {{plan_level_field_id}}, "value": ["INTERMEDIATE"] }
  //   ],
    "features": [
      {
        "featureId": 10,
        "fields": [
          {
            "fieldId": 17,
            "value": 54
          }
        ]
      }
    ]
  }
}

tests {
  test("Updates the plan created by this collection", function () {
    expect(res.getStatus()).to.equal(200);
    const { success, data } = res.getBody();
    expect(success).to.equal(true);
    expect(String(data.planId)).to.equal(bru.getVar("created_coach_plan_id"));
    expect(data.price).to.equal(130000);
    expect(data.compareAtPrice).to.equal(130000);
    expect(data.description).to.equal(null);
    expect(data.includes).to.deep.equal(["WORKOUT"]);
    expect(data.featureIds).to.deep.equal([Number(bru.getVar("plan_review_feature_id"))]);
    expect(data.features[0]).to.include({ id: data.featureIds[0], code: "PERIODIC_PLAN_REVIEW" });
    expect(data.features[0].label).to.be.a("string").and.not.be.empty;
    const answerFor = (code) => data.fieldValues.find((answer) => answer.code === code);
    expect(answerFor("WEEKLY_TRAINING_SESSIONS").value).to.equal(4);
    const review = answerFor("REVIEW_INTERVAL_DAYS");
    expect(review.value).to.equal(14);
    expect(review.featureId).to.equal(data.featureIds[0]);
    expect(review.label).to.be.a("string").and.not.be.empty;
  });
}

docs {
  Run Get coach plan form options, Get coach plan feature details, and Create coach plan in the same environment.
  This example edits the created plan, clears its description, and sets the general training frequency and feature review interval.
  A body with {"price":130000} sets both prices to 130000. Include compareAtPrice to set a separate comparison price.
  Send {"compareAtPrice":150000} to edit just the comparison price. Each supplied includes or features array specifies the full selection to keep.
  Each fields array updates only the answers listed. Send value as null to clear an optional answer.
}
