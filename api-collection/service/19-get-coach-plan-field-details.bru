meta {
  name: Get coach plan field details
  type: http
  seq: 19
}

get {
  url: {{base_url}}/api/v1/coaches/me/plan/form-options/fields/{{plan_field_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{process.env.USER_BEARER_TOKEN}}
}

vars:pre-request {
  plan_field_id: 13
}

tests {
  test("Returns one field definition with its validation rules", function () {
    expect(res.getStatus()).to.equal(200);
    const { success, data } = res.getBody();
    expect(success).to.equal(true);
    expect(data).to.include.all.keys("id", "code", "label", "valueType", "required", "validationRules");
    expect(data.validationRules).to.be.an("object");
    if (data.code === "PLAN_LEVEL") {
      expect(data.required).to.equal(true);
      expect(data.valueType).to.equal("MULTI_SELECT");
      expect(data.validationRules.options).to.be.a("array").that.is.not.empty;
    }
  });
}

docs {
  Set USER_BEARER_TOKEN to a COACH access token. In Vars, take plan_field_id from data.generalFields in Get coach plan form options or data.fields in Get coach plan feature details.
  
  The response contains one field definition in data. PLAN_LEVEL is required and exposes its choices in data.validationRules.options.
}
